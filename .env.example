# --- Приложение ---
PROJECT_NAME=Debureaucratizer
DEBUG=true
API_PORT=8000

# --- База данных ---
# Для локальной разработки (SQLite) или Docker (Postgres)
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql://rung_user:rung_password@db:5432/rung_db

# --- Auth ---
# Сгенерировать: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- LLM: Ollama (основной) ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b
# Движки: auto | ollama | huggingface
TRANSLATION_ENGINE=auto
AGENT_ENGINE=auto
FALLBACK_TO_HF_ON_ERROR=true

# --- LLM: HuggingFace (запасной) ---
HF_MODEL=facebook/nllb-200-distilled-600M
HF_AGENT_MODEL=
HF_TOKEN=

# --- Ensemble ---
ENSEMBLE_MODELS=qwen2.5:7b

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=tm_entries

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Режимы ---
EVAL_MODE=full
CACHEABLE_DOMAIN=general

# --- CORS ---
CORS_ORIGINS=http://localhost:8501

# --- Логирование ---
LOG_JSON=false

# --- Eval-скрипты ---
EVAL_PAIRS=bureau_plain
EVAL_SIZES=100
EVAL_MAX_SRC_LEN=512
EVAL_NEWS_MIN_KEEP=0
